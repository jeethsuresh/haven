# Production example. For local development, use scripts/dev.sh instead.
HAVEN_APP_URL=https://haven.example.com
GRAVITAS_ISSUER=https://gravitas.cool
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
